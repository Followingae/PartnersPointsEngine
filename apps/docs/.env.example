# Access codes for the developer portal, one per partner, so a single partner
# can be cut off without disturbing the others. Format: label=code,label=code
# Labels are lowercase letters/digits/hyphens. Codes are whatever you issue.
DOCS_ACCESS_CODES=till=change-me

# Secret used to sign the session cookie. Any long random string. Rotating it
# signs everyone out. Falls back to hashing the access codes if unset.
DOCS_COOKIE_SECRET=

# Public origin of the portal, used for absolute links (e.g. in the OpenAPI file).
NEXT_PUBLIC_PORTAL_URL=https://developers.partnerspoints.ae
