{
  "expo": {
    "name": "Partners Points",
    "slug": "partners-points",
    "scheme": "partnerspoints",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F3EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.partnerspoints.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ae.partnerspoints.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B04D9"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Partners Points uses the camera to scan the code at a till so you can join a brand and collect points.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Partners Points uses Face ID to unlock your wallet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "following",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58eef0fa-e7e1-4e99-8df5-0d08b0fa6f48"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58eef0fa-e7e1-4e99-8df5-0d08b0fa6f48"
    }
  }
}
