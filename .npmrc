auto-install-peers=true
strict-peer-dependencies=false
# Prisma + NestJS rely on packages that ship binaries / build scripts.
enable-pre-post-scripts=true

# Expo + Metro resolve transitive dependencies from a flat tree; pnpm's
# default isolated layout hides them, so expo-notifications fails to bundle on
# a package it never declares directly. Hoisting is what Expo documents for
# pnpm, and is preferable to vendoring Node polyfills into a React Native app.
node-linker=hoisted
